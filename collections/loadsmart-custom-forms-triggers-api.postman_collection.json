{
  "item": [
    {
      "id": "382cd4af-98ca-45d8-8408-38bb88755719",
      "name": "Custom Forms - Triggers",
      "description": {
        "content": "Triggers are event listeners that activate on specific API or UI events. Each Trigger is associated with exactly one Flow. When a Trigger fires, it initiates its associated Flow, which in turn presents one or two Forms sequentially.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "3c73ef00-82f5-4751-bf60-9c2418ad83b2",
          "name": "Update custom forms for load types",
          "request": {
            "name": "Update custom forms for load types",
            "description": {
              "content": "Updates existing custom forms' names and their associations with load types.\n\n    This endpoint allows you to:\n    - Modify the display name of custom forms\n    - Change which load types trigger these forms\n    - Update form visibility settings\n\n    For Delete a loadtype custom form, please refer to custom-forms/flow endpoint sending the flowId to delete all related flows/forms.\n    Note: To modify the fields within forms, use the '/custom-forms/form-field' endpoint.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "warehouse",
                ":id",
                "custom-forms"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loadTypeIds\": [\n    \"<array>\",\n    \"<array>\"\n  ],\n  \"formName\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
