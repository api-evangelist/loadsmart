            "url": "https://neutron.opendock.com/yard/view/spot-grid",
            "params": [
              {
                "name": "warehouseId",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get lean spot grid data optimized for grid view rendering"
